# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (FE, BE 등 하위 폴더 포함)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 점으로 시작하지 않아 위 규칙에 안 걸리는 비밀 파일들. 넓은 글롭(env.*)을 쓰면
# FE/lib/ai/server/env.ts 같은 소스까지 잡히므로 경로를 콕 집는다.
/INFRA/env.local
/BE/env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 작업 기록(docs/update)은 로컬 전용, 그 외 docs 문서는 추적한다
docs/*
!docs/be/
!docs/fe/
!docs/branch/
!docs/commit/
!docs/db/
!docs/infra/
!docs/ai/


# claude code local settings
.claude/settings.local.json

# python bytecode
__pycache__/
*.pyc
# graphify 지식 그래프 (로컬 전용)
/graphify-out

# IDE 로컬 설정
.idea/

# 환경변수 파일
/BE/.env
/FE/.env
/INFRA/.env

# 에이전트 스킬은 개인 로컬에서만 사용 가능하도록 설정
.agents/
.claude/
skills-lock.json

# FE 더미데이터 작업 폴더 (개인 로컬 전용)
FE/mock/

# FE 개인 로컬 지침 (개발자별 상이)
FE/CLAUDE.md

/BE/docs

# 부하 테스트 — 로컬 전용. PUBLIC 저장소에 서버 상한 · 테스트 계정 패턴 같은 공격 단서를 남기지 않는다
INFRA/loadtest/

# AI 정확도 검수 질문 세트 — 내부 검수용, 저장소에 두지 않는다
docs/ai/ai-question-set.md
