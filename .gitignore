# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (FE, BE 등 하위 폴더 포함)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 작업 기록(docs/update)은 로컬 전용, 그 외 docs 문서는 추적한다
docs/*
!docs/be/
!docs/branch/
!docs/commit/
!docs/db/


# claude code local settings
.claude/settings.local.json

# python bytecode
__pycache__/
*.pyc
# graphify 지식 그래프 (로컬 전용)
/graphify-out

# IDE 로컬 설정
.idea/

# 환경변수 파일
/BE/.env
/FE/.env
/INFRA/.env

# 에이전트 스킬은 개인 로컬에서만 사용 가능하도록 설정
.agents/
.claude/
skills-lock.json

# FE 더미데이터 작업 폴더 (개인 로컬 전용)
FE/mock/

# FE 개인 로컬 지침 (개발자별 상이)
FE/CLAUDE.md

/BE/docs