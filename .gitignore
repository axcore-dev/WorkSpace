# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (FE, BE 등 하위 폴더 포함)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 작업 기록(docs/update)은 로컬 전용, 그 외 docs 문서는 추적한다
/docs/update/
/docs/레퍼런스/
/docs/수정 요청 사항/
/docs/레퍼런스/
/docs/기타문서/


# claude code local settings
.claude/settings.local.json

# python bytecode
__pycache__/
*.pyc
# graphify 지식 그래프 (로컬 전용)
/graphify-out

# IDE 로컬 설정
.idea/
