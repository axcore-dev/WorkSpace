# axcore 리버스 프록시 (nginx 이미지의 envsubst 가 ${PUBLIC_HOST} 를 채운다).
#
#   :80   /.well-known/acme-challenge/ → certbot 웹루트 (Let's Encrypt HTTP-01)
#         /nginx-health                → 컨테이너 헬스체크
#         그 외                        → https://${PUBLIC_HOST} 로 301
#   :443  ${PUBLIC_HOST} 가 아닌 이름(apex, IP) → https://${PUBLIC_HOST} 로 301
#   :443  ${PUBLIC_HOST}  /api/ → BE (Spring, app:8080)   BE 컨트롤러는 전부 /api/ 로 시작한다.
#                         /ai/  → FE (Next.js) 의 Route Handler. SSE 스트리밍이라 버퍼링을 끈다.
#                         /     → FE (Next.js, frontend:8000) _next/static 포함 나머지 전부.
#
# FE 의 Route Handler 를 /api/ 아래에 두지 않는 이유: 여기서 /api/ 를 전부 Spring 으로 보내므로
# FE/app/api/** 는 배포하면 절대 안 불린다. next dev 로 8000 에 직접 붙을 때만 동작해서,
# 로컬에서는 멀쩡하고 운영에서만 깨진다. 그래서 FE 쪽은 /ai/ 로 분리했다 (PR #30).
#
# 인증서 경로는 /etc/nginx/ssl-current/ 심볼릭 링크다(snippets/tls.conf). 15-tls-bootstrap.sh 가
# Let's Encrypt 인증서가 있으면 그쪽을, 없으면 임시 자체서명을 가리키게 하고, 바뀌면 reload 한다.
#
# upstream 블록 대신 변수 + resolver 를 쓰는 이유: upstream 은 기동 시 한 번만 DNS 를 풀어서,
# FE 만 다시 배포해 컨테이너 IP 가 바뀌면 nginx 를 재시작하기 전까지 502 가 난다.
# 변수로 proxy_pass 하면 요청마다(valid 주기로) Docker 내장 DNS(127.0.0.11)에 다시 묻는다.

resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------- :80
server {
    listen 80 default_server;
    server_name _;

    # 컨테이너 헬스체크용. 업스트림·인증서와 무관하게 nginx 자체만 확인한다.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Let's Encrypt HTTP-01. certbot 이 certbot-www 볼륨에 토큰 파일을 쓰고, LE 서버가 여기로 가져간다.
    # 리다이렉트보다 먼저 잡혀야 하므로 ^~ 로 정규식보다 우선한다.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://${PUBLIC_HOST}$request_uri;
    }
}

# ---------------------------------------------------------------- :443 기본 (대표 주소가 아닌 이름)
# apex(axcore.it.kr), IP, 기타 이름으로 들어오면 대표 주소로 보낸다. 인증서에 apex 도 들어 있어야
# 브라우저 경고 없이 리다이렉트된다 (TLS_DOMAINS 에 둘 다 넣는다).
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    include /etc/nginx/snippets/tls.conf;

    return 301 https://${PUBLIC_HOST}$request_uri;
}

# ---------------------------------------------------------------- :443 앱
server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};
    include /etc/nginx/snippets/tls.conf;

    # HSTS. 처음엔 1주로 두고, HTTPS 가 안정되면 31536000(1년)으로 올린다.
    # 자체서명(로컬)에서는 브라우저가 무시한다.
    add_header Strict-Transport-Security "max-age=604800" always;

    # 프록시 뒤에 있음을 앱에 알린다. BE 는 SERVER_FORWARD_HEADERS_STRATEGY=framework 로
    # 이 헤더를 읽어 리다이렉트 URL 과 쿠키 Secure 판단을 원래 스킴·호스트 기준으로 한다.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_http_version 1.1;

    client_max_body_size 20m;
    proxy_read_timeout   60s;

    # BE. 끝의 슬래시 없이 변수로 넘기면 원래 URI 가 그대로 전달된다.
    #
    # BE 가 나중에 AI 스트리밍(/api/ai/chat)을 가져가면 아래 /ai/ 블록과 같은 두 줄
    # (proxy_buffering off, proxy_read_timeout)을 여기에도 넣어야 한다. 그리고 Spring 쪽에
    # spring.mvc.async.request-timeout 을 이 값과 짝으로 맞춰야 한다 — 그게 없으면 톰캣
    # 기본값(30s)에서 스트림이 먼저 끊긴다.
    location /api/ {
        set $backend http://app:8080;
        proxy_pass $backend;
        # Spring Security 도 X-Forwarded-Proto=https 를 보고 HSTS(1년·includeSubDomains)를 붙인다.
        # 브라우저는 첫 번째 HSTS 만 따르므로 업스트림 것을 숨기고 nginx 값 하나로 통일한다 (정책은 nginx 에서만).
        proxy_hide_header Strict-Transport-Security;
    }

    # FE 의 AI Route Handler (SSE). PR #30 에서 default.conf 에 넣은 것을 템플릿으로 옮겼다.
    #
    # proxy_buffering 기본값은 on 이다. 켜져 있으면 nginx 가 응답을 자기 버퍼에 모았다가
    # 버퍼가 차거나 업스트림이 연결을 닫을 때 내보낸다. SSE 는 버퍼를 채울 일이 없어서
    # 스트림이 끝날 때까지 브라우저에 한 바이트도 안 가고, 마지막에 전부 한꺼번에 도착한다.
    # 화면에서는 "30초 멈췼다가 답을 한 번에 뱉음" 으로 보인다.
    #
    # AI SDK 가 응답에 X-Accel-Buffering: no 를 붙여 주기는 하지만, 스트리밍 동작을 헤더 하나에
    # 걸어 두지 않는다. 앞에 프록시가 하나 더 끼면(ALB·Cloudflare) 그쪽은 이 헤더를 안 본다.
    #
    # read_timeout 은 업스트림에서 한 바이트도 안 오는 것을 얼마나 참는지다. server 블록의
    # 60s 를 그대로 두면 tool 이 여러 번 도는 턴에서 조회 하나가 길어질 때 504 로 끊긴다.
    #
    # 접두어가 /ai/ 라 /ai-chat 페이지와는 겹치지 않는다(그쪽은 아래 location / 로 간다).
    location /ai/ {
        set $ai http://frontend:8000;
        proxy_pass $ai;
        proxy_buffering     off;
        proxy_read_timeout  300s;
    }

    # FE. Upgrade 헤더는 지금은 쓰지 않지만 실시간 기능이 붙을 때 필요하다.
    location / {
        set $frontend http://frontend:8000;
        proxy_pass $frontend;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
